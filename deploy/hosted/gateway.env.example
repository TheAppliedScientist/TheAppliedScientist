HOSTED_HASH_SECRET=replace-with-a-random-secret-at-least-32-characters-long
HOSTED_DB_PATH=/var/lib/theappliedscientist/hosted/jobs.db
HOSTED_SEARCH_URL=http://127.0.0.1:8081
HOSTED_REVIEW_URL=http://127.0.0.1:8082
HOSTED_PUBLIC_HOST=replace-with-your-public-hostname
HOSTED_REVIEW_ARCHIVE_DIR=/var/lib/theappliedscientist/reviews
HOSTED_RETAIN_DAYS=7
HOSTED_MAX_PENDING=10
HOSTED_REVIEWS_PER_IP_DAY=3
HOSTED_REVIEWS_GLOBAL_DAY=24
HOSTED_SEARCHES_PER_IP_HOUR=60
HOSTED_QUERIES_PER_IP_HOUR=10
