# TheAppliedScientist configuration
# Copy to .env or run: ./tas setup

# Runtime used by the selected components: docker (recommended) or native.
# Search is lightweight and runs natively unless explicitly requested in Docker.
TAS_RUNTIME=docker
# Comma-separated components installed on this machine. Any subset is valid.
TAS_COMPONENTS=search,reviewer,scientist
# Set by `tas setup --dockerize-search`; otherwise Search uses native Python.
TAS_DOCKERIZE_SEARCH=0
# Absolute repository path. `./tas setup` fills this automatically.
TAS_PROJECT_ROOT=

# Claude Code speaks Anthropic Messages format. This endpoint MUST implement it.
# DeepSeek example: https://api.deepseek.com/anthropic
# Direct Anthropic: https://api.anthropic.com
# OpenAI-only endpoint: point this to your OpenAI -> Anthropic converter.
ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic
ANTHROPIC_AUTH_TOKEN=
# Kept in sync by `tas setup`; older Harbor integrations read this name.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=deepseek-v4-pro[1m]
ANTHROPIC_DEFAULT_OPUS_MODEL=deepseek-v4-pro[1m]
ANTHROPIC_DEFAULT_SONNET_MODEL=deepseek-v4-pro[1m]
ANTHROPIC_DEFAULT_HAIKU_MODEL=deepseek-v4-flash
CLAUDE_CODE_SUBAGENT_MODEL=deepseek-v4-flash
CLAUDE_CODE_EFFORT_LEVEL=
CLAUDE_CODE_AUTO_COMPACT_WINDOW=300000
CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1
CLAUDE_CODE_ATTRIBUTION_HEADER=0

# Optional per-component overrides. Each URL is the root of an Anthropic
# Messages-compatible API. Leave blank to inherit ANTHROPIC_* above.
SCIENTIST_ANTHROPIC_BASE_URL=
SCIENTIST_ANTHROPIC_API_KEY=
SCIENTIST_ANTHROPIC_MODEL=
REVIEW_ANTHROPIC_BASE_URL=
REVIEW_ANTHROPIC_API_KEY=

# Reviewer defaults match the reference reviewer runs.
REVIEW_MODEL=deepseek-v4-flash
REVIEW_REASONING_EFFORT=high
CLAUDE_CODE_VERSION=2.1.101

# Search embeddings. The published index was built with Gemini Embedding 2;
# this key is required for vector queries even if another LLM handles /query_paper.
GEMINI_API_KEY=
GEMINI_INDEX_HF_REPO=Vidushee/arxiv-gemini-index
GEMINI_INDEX_DIR=./data/search-index/arxiv_gemini_index

# Full-paper context distillation used by Search /query_paper.
# Values: gemini (reference default), anthropic, openai.
SEARCH_QUERY_API_FORMAT=gemini
SEARCH_QUERY_BASE_URL=
SEARCH_QUERY_API_KEY=
SEARCH_QUERY_MODEL=gemini-3-flash-preview

# Generic OpenAI-format interface for components explicitly using that format.
# Never point Claude Code at this URL.
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=

# Reviewer/Scientist execution is entirely local. `docker` uses local Docker
# isolation; `native` invokes Claude Code directly in a per-job workspace.
REVIEW_EXECUTION_BACKEND=docker
SCIENTIST_EXECUTION_BACKEND=docker
CLAUDE_REVIEW_BIN=./.runtime/claude-reviewer/node_modules/.bin/claude
CLAUDE_SCIENTIST_BIN=./.runtime/claude-scientist/node_modules/.bin/claude

# Local defaults work for native services. Sandboxed agents need externally
# reachable URLs; `tas doctor` detects this and explains the available options.
SEARCH_PUBLIC_URL=http://localhost:8081
REVIEW_API_URL=http://localhost:8082
# URLs seen from Docker containers. Override these for split-machine deployments.
REVIEWER_SEARCH_API_URL=http://host.docker.internal:8081
SCIENTIST_SEARCH_API_URL=http://host.docker.internal:8081
SCIENTIST_REVIEW_API_URL=http://host.docker.internal:8082
SEARCH_API_PORT=8081
REVIEW_API_PORT=8082

# Optional integrations
S2_API_KEY=
GITLAB_KEY=
