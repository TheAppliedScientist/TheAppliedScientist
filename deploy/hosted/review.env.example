ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic
ANTHROPIC_API_KEY=replace-with-an-anthropic-format-key
ANTHROPIC_AUTH_TOKEN=replace-with-an-anthropic-format-key
REVIEW_MODEL=deepseek-v4-flash
REVIEW_REASONING_EFFORT=high
REVIEW_EXECUTION_BACKEND=native
CLAUDE_REVIEW_BIN=/opt/theappliedscientist/.runtime/claude-reviewer/node_modules/.bin/claude
SEARCH_PUBLIC_URL=http://127.0.0.1:8081
TRAJECTORY_ARCHIVE_DIR=/var/lib/theappliedscientist/reviews
TAS_NATIVE_JOB_DIR=/var/lib/theappliedscientist/jobs
REVIEW_RETENTION_DAYS=7
